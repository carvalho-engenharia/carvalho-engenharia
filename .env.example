# Copie para .env (ignorado pelo git) e preencha. Usado por: npm run indexar

# Conteúdo do JSON da service account (em uma linha) OU caminho do arquivo,
# de preferência fora do repositório. Ex.: C:/Users/user/chaves/indexador.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# Propriedade do Search Console:
#   tipo Domínio:          sc-domain:carvalho-engenharia.com
#   tipo Prefixo de URL:   https://www.carvalho-engenharia.com/
GSC_SITE_URL=sc-domain:carvalho-engenharia.com

# Chave IndexNow. Não é secreta: fica pública em public/<chave>.txt
INDEXNOW_KEY=06b50f76ec8615ca3f9c71948bb33529
